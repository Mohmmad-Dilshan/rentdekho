# PostgreSQL connection URL for local development and deployment.
# Set a real value only in your ignored local environment or host configuration.
DATABASE_URL=

# Required for Better Auth to sign, encrypt, and hash authentication data.
# Generate a strong value (for example: openssl rand -base64 32) and keep it secret.
BETTER_AUTH_SECRET=

# Public origin serving this application, without a trailing slash.
# Example development value: http://localhost:3000
BETTER_AUTH_URL=

# Optional comma-separated additional origins trusted for authentication requests.
# Leave empty when the application is served from a single origin.
BETTER_AUTH_TRUSTED_ORIGINS=
